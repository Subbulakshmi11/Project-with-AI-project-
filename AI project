<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>AI Smart Event Planner</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #f5f7fb;
    color: #172033;
}

/* NAVBAR */
.navbar {
    width: 100%;
    background: white;
    padding: 18px 7%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #e5e7eb;
    position: sticky;
    top: 0;
    z-index: 100;
}

.logo {
    font-size: 22px;
    font-weight: bold;
    color: #4f46e5;
}

.nav-links {
    display: flex;
    gap: 25px;
}

.nav-links a {
    text-decoration: none;
    color: #4b5563;
    font-size: 15px;
}

.nav-links a:hover {
    color: #4f46e5;
}

/* HERO */
.hero {
    padding: 80px 7%;
    background: linear-gradient(135deg, #eef2ff, #ffffff);
}

.hero-container {
    max-width: 1200px;
    margin: auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    align-items: center;
}

.badge {
    display: inline-block;
    background: #e0e7ff;
    color: #4338ca;
    padding: 8px 15px;
    border-radius: 30px;
    font-size: 13px;
    font-weight: bold;
    margin-bottom: 20px;
}

.hero h1 {
    font-size: 52px;
    line-height: 1.1;
    margin-bottom: 20px;
}

.hero h1 span {
    color: #4f46e5;
}

.hero p {
    color: #667085;
    font-size: 18px;
    line-height: 1.7;
    margin-bottom: 30px;
}

.primary-btn {
    border: none;
    background: #4f46e5;
    color: white;
    padding: 14px 24px;
    border-radius: 10px;
    font-size: 16px;
    cursor: pointer;
    font-weight: bold;
}

.primary-btn:hover {
    background: #3730a3;
}

/* PREVIEW CARD */
.preview-card {
    background: #111827;
    color: white;
    border-radius: 22px;
    padding: 28px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.15);
}

.preview-top {
    display: flex;
    justify-content: space-between;
    margin-bottom: 25px;
}

.preview-title {
    font-size: 21px;
    font-weight: bold;
}

.status {
    background: #1f2937;
    color: #a5b4fc;
    padding: 7px 12px;
    border-radius: 20px;
    font-size: 12px;
}

.preview-budget {
    font-size: 32px;
    font-weight: bold;
    margin-bottom: 20px;
}

.progress {
    width: 100%;
    height: 9px;
    background: #374151;
    border-radius: 20px;
    overflow: hidden;
}

.progress div {
    width: 72%;
    height: 100%;
    background: #818cf8;
}

.preview-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
    margin-top: 25px;
}

.preview-box {
    background: #1f2937;
    padding: 18px;
    border-radius: 12px;
}

.preview-box small {
    color: #9ca3af;
}

.preview-box strong {
    display: block;
    margin-top: 8px;
}

/* SECTION */
.section {
    padding: 75px 7%;
}

.section-title {
    text-align: center;
    max-width: 700px;
    margin: auto;
}

.section-title h2 {
    font-size: 36px;
    margin-bottom: 12px;
}

.section-title p {
    color: #667085;
    line-height: 1.6;
}

/* FEATURES */
.features {
    max-width: 1200px;
    margin: 45px auto 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.feature {
    background: white;
    padding: 25px;
    border-radius: 16px;
    border: 1px solid #e5e7eb;
}

.icon {
    width: 45px;
    height: 45px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #eef2ff;
    color: #4f46e5;
    border-radius: 12px;
    font-size: 20px;
    margin-bottom: 18px;
}

.feature h3 {
    margin-bottom: 10px;
}

.feature p {
    color: #667085;
    font-size: 14px;
    line-height: 1.6;
}

/* PLANNER */
.planner-section {
    background: #111827;
    color: white;
}

.planner-box {
    max-width: 900px;
    margin: 40px auto 0;
    background: white;
    color: #172033;
    padding: 35px;
    border-radius: 20px;
}

.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

.form-group {
    display: flex;
    flex-direction: column;
}

.form-group.full {
    grid-column: 1 / -1;
}

.form-group label {
    margin-bottom: 8px;
    font-weight: bold;
    font-size: 14px;
}

.form-group input,
.form-group select {
    padding: 13px;
    border: 1px solid #d1d5db;
    border-radius: 9px;
    font-size: 15px;
    outline: none;
}

.form-group input:focus,
.form-group select:focus {
    border-color: #4f46e5;
}

.generate-btn {
    width: 100%;
    margin-top: 25px;
    padding: 15px;
    border: none;
    background: #4f46e5;
    color: white;
    border-radius: 10px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
}

.generate-btn:hover {
    background: #3730a3;
}

/* RESULT */
#result {
    display: none;
}

.result-box {
    max-width: 1100px;
    margin: auto;
}

.result-header {
    background: #111827;
    color: white;
    padding: 28px;
    border-radius: 18px;
    margin-bottom: 20px;
}

.result-header h2 {
    margin-bottom: 8px;
}

.result-header p {
    color: #cbd5e1;
}

.result-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
    margin-bottom: 20px;
}

.result-card {
    background: white;
    padding: 22px;
    border-radius: 14px;
    border: 1px solid #e5e7eb;
}

.result-card span {
    display: block;
    color: #667085;
    font-size: 13px;
    margin-bottom: 8px;
}

.result-card strong {
    font-size: 24px;
}

.details-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

.detail-card {
    background: white;
    padding: 25px;
    border-radius: 15px;
    border: 1px solid #e5e7eb;
}

.detail-card h3 {
    margin-bottom: 15px;
}

.detail-card ul {
    padding-left: 20px;
}

.detail-card li {
    margin-bottom: 10px;
    color: #4b5563;
}

/* AI ASSISTANT */
.assistant {
    max-width: 850px;
    margin: 40px auto 0;
    background: white;
    border-radius: 18px;
    border: 1px solid #e5e7eb;
    overflow: hidden;
}

.chat-header {
    background: #111827;
    color: white;
    padding: 20px;
}

.chat-header h3 {
    margin-bottom: 5px;
}

.chat-header p {
    color: #cbd5e1;
    font-size: 13px;
}

.chat-body {
    height: 320px;
    padding: 20px;
    overflow-y: auto;
    background: #f9fafb;
}

.message {
    max-width: 75%;
    padding: 12px 15px;
    border-radius: 12px;
    margin-bottom: 12px;
    line-height: 1.5;
    font-size: 14px;
}

.bot {
    background: #e5e7eb;
    color: #172033;
}

.user {
    background: #4f46e5;
    color: white;
    margin-left: auto;
}

.chat-input {
    display: flex;
    padding: 15px;
    border-top: 1px solid #e5e7eb;
    gap: 10px;
}

.chat-input input {
    flex: 1;
    padding: 12px;
    border: 1px solid #d1d5db;
    border-radius: 9px;
    outline: none;
}

.chat-input button {
    padding: 12px 20px;
    border: none;
    background: #4f46e5;
    color: white;
    border-radius: 9px;
    cursor: pointer;
}

/* FOOTER */
footer {
    background: #111827;
    color: white;
    text-align: center;
    padding: 30px;
    margin-top: 50px;
}

footer p {
    color: #9ca3af;
    margin-top: 8px;
}

/* MOBILE */
@media (max-width: 900px) {

    .hero-container {
        grid-template-columns: 1fr;
    }

    .features {
        grid-template-columns: 1fr 1fr;
    }

    .result-grid {
        grid-template-columns: 1fr 1fr;
    }

}

@media (max-width: 600px) {

    .nav-links {
        display: none;
    }

    .hero h1 {
        font-size: 38px;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }

    .form-group.full {
        grid-column: auto;
    }

    .features {
        grid-template-columns: 1fr;
    }

    .result-grid {
        grid-template-columns: 1fr;
    }

    .details-grid {
        grid-template-columns: 1fr;
    }

    .planner-box {
        padding: 20px;
    }

}
</style>
</head>

<body>

<!-- NAVBAR -->
<nav class="navbar">

    <div class="logo">
        EventAI
    </div>

    <div class="nav-links">
        <a href="#home">Home</a>
        <a href="#features">Features</a>
        <a href="#planner">Planner</a>
        <a href="#assistant">AI Assistant</a>
    </div>

</nav>


<!-- HERO -->
<section class="hero" id="home">

    <div class="hero-container">

        <div>

            <div class="badge">
                AI POWERED EVENT PLANNER
            </div>

            <h1>
                Plan your event
                <span>smarter.</span>
            </h1>

            <p>
                Create professional event plans with smart budget
                planning, food suggestions, decoration ideas and
                an AI event assistant.
            </p>

            <button class="primary-btn" onclick="openPlanner()">
                Create My Event
            </button>

        </div>


        <div class="preview-card">

            <div class="preview-top">

                <div class="preview-title">
                    Birthday Celebration
                </div>

                <div class="status">
                    AI Planned
                </div>

            </div>

            <div class="preview-budget">
                ₹50,000
            </div>

            <div class="progress">
                <div></div>
            </div>

            <div class="preview-grid">

                <div class="preview-box">
                    <small>Guests</small>
                    <strong>100 People</strong>
                </div>

                <div class="preview-box">
                    <small>Food</small>
                    <strong>Veg & Non-Veg</strong>
                </div>

                <div class="preview-box">
                    <small>Theme</small>
                    <strong>Elegant</strong>
                </div>

                <div class="preview-box">
                    <small>Status</small>
                    <strong>Ready</strong>
                </div>

            </div>

        </div>

    </div>

</section>


<!-- FEATURES -->
<section class="section" id="features">

    <div class="section-title">

        <h2>Everything you need</h2>

        <p>
            A simple event planning system that helps you
            organize your event from one place.
        </p>

    </div>


    <div class="features">

        <div class="feature">

            <div class="icon">AI</div>

            <h3>AI Recommendations</h3>

            <p>
                Get event ideas based on your event type,
                guests, budget and preferences.
            </p>

        </div>


        <div class="feature">

            <div class="icon">₹</div>

            <h3>Smart Budget</h3>

            <p>
                Automatically divide your budget into
                venue, food, decoration and activities.
            </p>

        </div>


        <div class="feature">

            <div class="icon">✓</div>

            <h3>Event Tasks</h3>

            <p>
                Get useful tasks and planning suggestions
                for your event.
            </p>

        </div>


        <div class="feature">

            <div class="icon">?</div>

            <h3>AI Assistant</h3>

            <p>
                Ask questions about food, decoration,
                budget and event planning.
            </p>

        </div>

    </div>

</section>


<!-- PLANNER -->
<section class="section planner-section" id="planner">

    <div class="section-title">

        <h2>Build your event plan</h2>

        <p>
            Enter your event details and generate a smart
            event plan instantly.
        </p>

    </div>


    <div class="planner-box">

        <form id="eventForm">

            <div class="form-grid">

                <div class="form-group">

                    <label>Event Name</label>

                    <input
                        type="text"
                        id="eventName"
                        placeholder="Example: Birthday Party"
                        required
                    >

                </div>


                <div class="form-group">

                    <label>Event Type</label>

                    <select id="eventType">

                        <option>Birthday</option>
                        <option>Wedding</option>
                        <option>College Event</option>
                        <option>Corporate Event</option>
                        <option>Family Function</option>
                        <option>Other</option>

                    </select>

                </div>


                <div class="form-group">

                    <label>Number of Guests</label>

                    <input
                        type="number"
                        id="guests"
                        placeholder="100"
                        min="1"
                        required
                    >

                </div>


                <div class="form-group">

                    <label>Location</label>

                    <input
                        type="text"
                        id="location"
                        placeholder="Example: Chennai"
                        required
                    >

                </div>


                <div class="form-group">

                    <label>Total Budget (₹)</label>

                    <input
                        type="number"
                        id="budget"
                        placeholder="50000"
                        min="1000"
                        required
                    >

                </div>


                <div class="form-group">

                    <label>Food Preference</label>

                    <select id="food">

                        <option>Vegetarian</option>
                        <option>Non-Vegetarian</option>
                        <option>Veg & Non-Veg</option>

                    </select>

                </div>


                <div class="form-group full">

                    <label>Event Theme</label>

                    <select id="theme">

                        <option>Modern</option>
                        <option>Elegant</option>
                        <option>Traditional</option>
                        <option>Colorful</option>

                    </select>

                </div>

            </div>


            <button
                type="submit"
                class="generate-btn"
            >
                Generate AI Event Plan
            </button>

        </form>

    </div>

</section>


<!-- RESULT -->
<section class="section" id="result">

    <div class="result-box">

        <div class="result-header">

            <h2 id="resultTitle">
                Your Event Plan
            </h2>

            <p id="resultDescription">
                Your personalized event plan is ready.
            </p>

        </div>


        <div class="result-grid">

            <div class="result-card">

                <span>Total Budget</span>

                <strong id="totalBudget">
                    ₹0
                </strong>

            </div>


            <div class="result-card">

                <span>Guests</span>

                <strong id="totalGuests">
                    0
                </strong>

            </div>


            <div class="result-card">

                <span>Food Budget</span>

                <strong id="foodBudget">
                    ₹0
                </strong>

            </div>


            <div class="result-card">

                <span>Venue Budget</span>

                <strong id="venueBudget">
                    ₹0
                </strong>

            </div>

        </div>


        <div class="details-grid">

            <div class="detail-card">

                <h3>Food Suggestions</h3>

                <ul id="foodList"></ul>

            </div>


            <div class="detail-card">

                <h3>Decoration Ideas</h3>

                <ul id="decorationList"></ul>

            </div>


            <div class="detail-card">

                <h3>Event Schedule</h3>

                <ul id="scheduleList"></ul>

            </div>


            <div class="detail-card">

                <h3>Planning Tasks</h3>

                <ul id="taskList"></ul>

            </div>

        </div>

    </div>

</section>


<!-- AI ASSISTANT -->
<section class="section" id="assistant">

    <div class="section-title">

        <h2>AI Event Assistant</h2>

        <p>
            Ask the assistant anything about your event.
        </p>

    </div>


    <div class="assistant">

        <div class="chat-header">

            <h3>EventAI Assistant</h3>

            <p>Planning assistant</p>

        </div>


        <div class="chat-body" id="chatBody">

            <div class="message bot">
                Hello! I can help you with budget, food,
                decoration, activities and event schedules.
            </div>

        </div>


        <div class="chat-input">

            <input
                type="text"
                id="chatInput"
                placeholder="Ask something..."
            >

            <button onclick="sendMessage()">
                Send
            </button>

        </div>

    </div>

</section>


<!-- FOOTER -->
<footer>

    <h3>EventAI</h3>

    <p>
        AI Smart Event Planner
    </p>

</footer>


<script>

/* OPEN PLANNER */
function openPlanner() {

    document.getElementById("planner").scrollIntoView({
        behavior: "smooth"
    });

}


/* EVENT FORM */
document.getElementById("eventForm").addEventListener(
    "submit",
    function(event) {

        event.preventDefault();

        generatePlan();

    }
);


/* GENERATE PLAN */
function generatePlan() {

    var eventName =
        document.getElementById("eventName").value;

    var eventType =
        document.getElementById("eventType").value;

    var guests =
        Number(document.getElementById("guests").value);

    var location =
        document.getElementById("location").value;

    var budget =
        Number(document.getElementById("budget").value);

    var food =
        document.getElementById("food").value;

    var theme =
        document.getElementById("theme").value;


    if (
        eventName === "" ||
        guests <= 0 ||
        location === "" ||
        budget <= 0
    ) {

        alert("Please enter all event details.");

        return;

    }


    /* BUDGET CALCULATION */

    var venue = budget * 0.20;

    var foodCost = budget * 0.35;

    var decoration = budget * 0.15;

    var activities = budget * 0.10;


    /* RESULT */

    document.getElementById("resultTitle").innerText =
        eventName + " - Event Plan";


    document.getElementById("resultDescription").innerText =
        eventType + " planned for " +
        guests +
        " guests in " +
        location +
        " with a " +
        theme +
        " theme.";


    document.getElementById("totalBudget").innerText =
        formatMoney(budget);


    document.getElementById("totalGuests").innerText =
        guests;


    document.getElementById("foodBudget").innerText =
        formatMoney(foodCost);


    document.getElementById("venueBudget").innerText =
        formatMoney(venue);


    /* FOOD */

    var foodList =
        document.getElementById("foodList");

    foodList.innerHTML = "";


    if (food === "Vegetarian") {

        addListItem(foodList, "Paneer starter");
        addListItem(foodList, "Vegetable biryani");
        addListItem(foodList, "Chapati and curry");
        addListItem(foodList, "Fresh juice");
        addListItem(foodList, "Ice cream");

    }

    else if (food === "Non-Vegetarian") {

        addListItem(foodList, "Chicken starter");
        addListItem(foodList, "Chicken biryani");
        addListItem(foodList, "Mutton curry");
        addListItem(foodList, "Fresh juice");
        addListItem(foodList, "Ice cream");

    }

    else {

        addListItem(foodList, "Paneer starter");
        addListItem(foodList, "Chicken starter");
        addListItem(foodList, "Veg biryani");
        addListItem(foodList, "Chicken biryani");
        addListItem(foodList, "Ice cream");

    }


    /* DECORATION */

    var decorationList =
        document.getElementById("decorationList");

    decorationList.innerHTML = "";

    addListItem(
        decorationList,
        theme + " stage decoration"
    );

    addListItem(
        decorationList,
        "Welcome board"
    );

    addListItem(
        decorationList,
        "Table decorations"
    );

    addListItem(
        decorationList,
        "Photo booth"
    );

    addListItem(
        decorationList,
        "Lighting setup"
    );


    /* SCHEDULE */

    var scheduleList =
        document.getElementById("scheduleList");

    scheduleList.innerHTML = "";

    addListItem(
        scheduleList,
        "4:00 PM - Guest arrival"
    );

    addListItem(
        scheduleList,
        "4:30 PM - Welcome"
    );

    addListItem(
        scheduleList,
        "5:00 PM - Main activity"
    );

    addListItem(
        scheduleList,
        "6:30 PM - Food service"
    );

    addListItem(
        scheduleList,
        "7:30 PM - Photos and closing"
    );


    /* TASKS */

    var taskList =
        document.getElementById("taskList");

    taskList.innerHTML = "";

    addListItem(
        taskList,
        "Book venue"
    );

    addListItem(
        taskList,
        "Confirm guest list"
    );

    addListItem(
        taskList,
        "Arrange food"
    );

    addListItem(
        taskList,
        "Arrange decoration"
    );

    addListItem(
        taskList,
        "Confirm event schedule"
    );


    /* SHOW RESULT */

    var result =
        document.getElementById("result");

    result.style.display = "block";

    result.scrollIntoView({
        behavior: "smooth"
    });

}


/* ADD LIST ITEM */
function addListItem(list, text) {

    var li =
        document.createElement("li");

    li.innerText = text;

    list.appendChild(li);

}


/* MONEY FORMAT */
function formatMoney(number) {

    return "₹" + Number(number).toLocaleString("en-IN");

}


/* CHAT */
function sendMessage() {

    var input =
        document.getElementById("chatInput");

    var message =
        input.value.trim();


    if (message === "") {

        return;

    }


    addChatMessage(
        message,
        "user"
    );


    input.value = "";


    setTimeout(function() {

        var answer =
            getAssistantAnswer(message);

        addChatMessage(
            answer,
            "bot"
        );

    }, 500);

}


/* ADD CHAT MESSAGE */
function addChatMessage(text, type) {

    var chat =
        document.getElementById("chatBody");

    var message =
        document.createElement("div");

    message.className =
        "message " + type;

    message.innerText = text;

    chat.appendChild(message);

    chat.scrollTop =
        chat.scrollHeight;

}


/* AI ASSISTANT RESPONSE */
function getAssistantAnswer(message) {

    var text =
        message.toLowerCase();


    if (
        text.includes("budget") ||
        text.includes("money") ||
        text.includes("cost")
    ) {

        return "For a balanced event budget, you can use around 20% for the venue, 35% for food, 15% for decoration and 10% for activities.";

    }


    if (
        text.includes("food") ||
        text.includes("menu")
    ) {

        return "For food, you can plan starters, a main course, drinks and dessert. I can also suggest vegetarian or non-vegetarian menus.";

    }


    if (
        text.includes("decoration") ||
        text.includes("decor")
    ) {

        return "Try a theme-based stage, welcome board, table decorations, photo booth and suitable lighting.";

    }


    if (
        text.includes("game") ||
        text.includes("activity")
    ) {

        return "You can include quizzes, musical games, team activities, photo sessions and fun audience games.";

    }


    if (
        text.includes("schedule") ||
        text.includes("time")
    ) {

        return "A simple schedule is: guest arrival, welcome, main activity, food service, photos and closing.";

    }


    if (
        text.includes("hello") ||
        text.includes("hi")
    ) {

        return "Hello! Tell me about your event and I will help you plan it.";

    }


    return "I can help you with event budget, food, decoration, activities and schedule. Try asking about one of these.";

}


/* ENTER KEY FOR CHAT */
document.getElementById("chatInput").addEventListener(
    "keydown",
    function(event) {

        if (event.key === "Enter") {

            sendMessage();

        }

    }
);

